NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/authdb
CLIENT_URL=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

REFRESH_TTL_DAYS=7

# Whoever registers with this email becomes an admin
ADMIN_EMAIL=admin@example.com

# Optional SMTP. Without it, emails are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Secure Auth <no-reply@example.com>"

# Set to 1 when running behind a reverse proxy (Render, Nginx, etc.)
TRUST_PROXY=0
